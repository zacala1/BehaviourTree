<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net6.0;net48;netstandard2.1;netstandard2.0</TargetFrameworks>

    <!-- NuGet Package Metadata -->
    <PackageId>BehaviourTree.Graph</PackageId>
    <Version>2.0.0</Version>
    <Authors>zacala1</Authors>
    <Company>zacala1</Company>
    <Product>BehaviourTree.Graph</Product>
    <Copyright>Copyright © 2025 zacala1</Copyright>

    <PackageTags>c#;csharp;behavior;behaviour;tree;behaviourtree;graph;visualization;plantuml;diagram</PackageTags>
    <Description>Graph visualization extensions for BehaviourTree library. Supports PlantUML and DanAbad text formats for behavior tree visualization.</Description>

    <PackageProjectUrl>https://github.com/zacala1/BehaviourTree</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zacala1/BehaviourTree.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Build Configuration -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BehaviourTree\BehaviourTree.csproj" />
  </ItemGroup>

  <!-- .NET Framework specific -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

</Project>
