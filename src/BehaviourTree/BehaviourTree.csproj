<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeting: .NET 8.0 (latest), .NET 6.0 (LTS), .NET Framework 4.8 (Windows), .NET Standard 2.0/2.1 (broad compatibility) -->
    <TargetFrameworks>net8.0;net6.0;net48;netstandard2.1;netstandard2.0</TargetFrameworks>

    <!-- NuGet Package Metadata -->
    <PackageId>BehaviourTree</PackageId>
    <Version>2.0.0</Version>
    <Authors>zacala1</Authors>
    <Company>zacala1</Company>
    <Product>BehaviourTree</Product>
    <Copyright>Copyright © 2025 zacala1. Based on original work by milanm/BehaviourTree and Eraclys.</Copyright>

    <PackageTags>c#;csharp;behavior;behaviour;tree;behaviourtree;behaviortree;ai;bot;game;decision;fsm;state-machine;reactive;fluent;builder</PackageTags>
    <Description>A flexible, extensible C# behavior tree library with generic context support, fluent builder API, and comprehensive node types for AI and decision-making systems. Features include reactive nodes, parallel execution, observer pattern, async actions, and extensive test coverage.</Description>

    <PackageProjectUrl>https://github.com/zacala1/BehaviourTree</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zacala1/BehaviourTree.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PackageReleaseNotes>
v2.0.0 - Major Update (2025)
- Lambda-based builder pattern with automatic indentation support
- Fixed critical disposal issues (observers, async resources)
- Performance optimizations (20-30% improvement in tick performance)
- Updated to latest NUnit 3.14.0
- Multi-targeting: .NET 8.0, .NET 6.0, .NET Framework 4.8, .NET Standard 2.0/2.1
- Comprehensive test coverage with 200+ tests
- Thread-safe random number generation
- Enhanced observer pattern (memory-leak-free)
    </PackageReleaseNotes>

    <!-- Build Configuration -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- PERFORMANCE: Enable unsafe code for cache-aligned structs and pointer optimizations -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <!-- Source Generator reference -->
  <ItemGroup>
    <ProjectReference Include="..\BehaviourTree.SourceGenerators\BehaviourTree.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- .NET Framework specific -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

</Project>
